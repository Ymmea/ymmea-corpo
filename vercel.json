{
  "buildCommand": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "ymmea.com" }],
      "destination": "https://www.ymmea.com/:path*",
      "permanent": true
    }
  ]
}
